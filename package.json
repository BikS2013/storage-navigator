{
  "name": "storage-navigator",
  "version": "1.0.0",
  "description": "Azure Blob Storage Navigator — CLI and Electron UI for browsing blob containers",
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "storage-nav": "bin/storage-nav.mjs"
  },
  "scripts": {
    "build": "tsc",
    "build:electron": "tsc",
    "dist:mac": "npm run build:electron && electron-builder --mac --arm64",
    "cli": "npx tsx src/cli/index.ts",
    "ui": "npx tsx src/cli/index.ts ui",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.giorgosmarinos.storage-navigator",
    "productName": "Storage Navigator",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "src/electron/public", "to": "public" },
      { "from": "src/electron/preload.cjs", "to": "preload.cjs" },
      { "from": "assets", "to": "assets" }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null
    }
  },
  "keywords": [
    "azure",
    "blob",
    "storage",
    "navigator",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@azure/storage-file-share": "^12.30.0",
    "@langchain/anthropic": "^1.3.27",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.4",
    "chalk": "^5.6.2",
    "clipboardy": "^4.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.3",
    "langchain": "^1.3.4",
    "mammoth": "^1.12.0",
    "marked": "^17.0.5",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "global-agent": "^4.1.3",
    "rimraf": "^6.1.3",
    "cacache": "^20.0.4",
    "brace-expansion": "^5.0.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.2",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
