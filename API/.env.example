# --- Required ---
AUTH_ENABLED=true

# Required when AUTH_ENABLED=true
OIDC_ISSUER=https://my.nbg.gr/identity
OIDC_AUDIENCE=storage-nav-api
OIDC_CLIENT_ID=replace-me
OIDC_SCOPES=openid,role,storage-nav-api
ROLE_MAP={"StorageReader":"Reader","StorageWriter":"Writer","StorageAdmin":"Admin"}

# Required when AUTH_ENABLED=false
# ANON_ROLE=Reader

# --- API keys (optional, works with either auth mode) ---
# Map each API key to a role. A request carrying API_KEY_HEADER with a known
# key is authenticated with that role and skips OIDC/anon. Unknown key -> 401.
# No key -> falls through to OIDC/anon. Store real keys in KeyVault, not here.
# API_KEYS={"replace-with-long-random":"Reader","another-long-random":"Admin"}
# API_KEY_HEADER=X-API-Key

# --- Optional ---
PORT=3000
LOG_LEVEL=info
OIDC_JWKS_CACHE_MIN=10
OIDC_CLOCK_TOLERANCE_SEC=30
ROLE_CLAIM=role
AZURE_SUBSCRIPTIONS=
ALLOWED_ACCOUNTS=
DISCOVERY_REFRESH_MIN=15
DEFAULT_PAGE_SIZE=200
MAX_PAGE_SIZE=1000
UPLOAD_MAX_BYTES=
STREAM_BLOCK_SIZE_MB=8
SWAGGER_UI_ENABLED=true
CORS_ORIGINS=
APPINSIGHTS_CONNECTION_STRING=
